# ── Public (safe in the browser) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://finallyfreeapp.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Fellowship (not personal) contact address shown on Get Help / Give
NEXT_PUBLIC_CONTACT_EMAIL=finallyfreefellowship@gmail.com

# ── Server only (never prefix with NEXT_PUBLIC_) ─────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TURNSTILE_SECRET_KEY=your-turnstile-secret
RESEND_API_KEY=re_xxx
EMAIL_FROM="Finally Free Fellowship <no-reply@finallyfreeapp.com>"
# Long random string; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate-a-long-random-string
# FF Signal group invite — shown only on member pages (Panic Button)
SIGNAL_GROUP_URL=https://signal.group/#...
